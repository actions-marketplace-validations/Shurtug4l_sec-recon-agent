# External APIs
ANTHROPIC_API_KEY=
NVD_API_KEY=
# Optional: enables GitHub Code Search for public PoC discovery in exploit_check.
# Without it the GitHub side gracefully degrades to []. Use a fine-grained PAT
# with public_repo read scope (no other scopes needed).
GITHUB_TOKEN=

# LLM
LLM_PROVIDER=anthropic
# Default: Haiku 4.5 — cheapest tier, sufficient for tool-calling + structured
# output. Override to claude-sonnet-4-6 for richer prose, or claude-opus-4-7
# for the strongest reasoning at ~10x the cost.
LLM_MODEL=claude-haiku-4-5-20251001

# Service binding
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8000

# Storage
CHROMA_PERSIST_DIR=./data/cve_index
# Local (non-Docker) default. In docker-compose the agent-api rootfs is
# read-only, so compose overrides this to /app/audit/audit.db on a dedicated
# writable volume; otherwise the audit trail cannot be written.
AUDIT_DB_PATH=./data/audit.db

# Audit trail (append-only SQLite with SHA-256 hash chain).
# AUDIT_LOG_ENABLED master switch: false disables persistence entirely.
# AUDIT_INCLUDE_QUERY / _SUMMARY: opt in to plain-text retention. Default
# off — only digests + aggregate counts are persisted, never the raw
# query or report summary.
AUDIT_LOG_ENABLED=true
AUDIT_INCLUDE_QUERY=false
AUDIT_INCLUDE_SUMMARY=false

# Authentication and rate limiting (API surface)
# API_KEYS: comma-separated list of accepted keys. Empty (default) leaves
# /v1/triage and /v1/meta open — fine for local dev, not for anything
# reachable beyond localhost. When set, every request must carry
# `Authorization: Bearer <key>` or `X-API-Key: <key>`. /v1/health stays
# public so container orchestrators can probe it.
API_KEYS=
# RATE_LIMIT_PER_MINUTE: per-IP cap on /v1/triage. 0 or unset disables.
# Set to 30-60 for a single-user demo; lower behind a real WAF.
RATE_LIMIT_PER_MINUTE=
# When API_KEYS is set, the Next.js proxy must forward one of those keys
# upstream. AGENT_API_KEY is read by the proxy only; never exposed to
# the browser.
AGENT_API_KEY=

# Per-run bounds. Each stops the run when hit; whatever the run consumed is
# still charged to the budget window and sealed into the audit trail, on
# every exit path (delivered, error, bound hit, client disconnect).
# AGENT_REQUEST_LIMIT: model rounds per triage (default 25).
# AGENT_TOOL_CALLS_LIMIT: tool calls per triage (default 40; rounds alone do
# not bound them, Anthropic models batch several calls per turn).
# AGENT_TOTAL_TOKENS_LIMIT: input + output tokens per triage (default 250000;
# the cost driver, since every round re-sends the whole conversation).
# TRIAGE_DEADLINE_SECONDS: wall clock per triage (default 300; a single NVD
# call can legitimately take ~75 s with retries). Empty keeps the default;
# `off` disables a bound (a deliberate choice, never the side effect of an
# unset variable).
AGENT_REQUEST_LIMIT=
AGENT_TOOL_CALLS_LIMIT=
AGENT_TOTAL_TOKENS_LIMIT=
TRIAGE_DEADLINE_SECONDS=

# Operational safety rails (S4)
# DENIAL_OF_WALLET_USD_PER_DAY: hard ceiling on estimated LLM spend over a
# rolling 24h window, summed in-process across all triage runs. Empty (default)
# disables it. Over the ceiling, /v1/triage returns 503 until older spend ages
# out. The per-run bounds above cap one run's cost; this bounds the aggregate
# an attacker can drive by repeating requests. Every run is charged from the
# generator's cleanup, so an aborted connection or a failed run counts what
# it consumed, not zero. The window resets on restart.
# Example: DENIAL_OF_WALLET_USD_PER_DAY=5
DENIAL_OF_WALLET_USD_PER_DAY=
# KILL_SWITCH: set to 1/true to disable /v1/triage (503) for the container's
# life. Empty (default) leaves it on.
KILL_SWITCH=
# KILL_SWITCH_FILE: when this path exists, /v1/triage returns 503; checked per
# request, so `docker exec sec-recon-api touch <path>` disables the service live
# and removing the file re-enables it, no restart. In docker-compose it defaults
# to a tmpfs path (cleared on restart); use KILL_SWITCH=1 for a persistent off.
KILL_SWITCH_FILE=

# Authentication on the MCP transport (mcp-server, :8001).
# MCP_AUTH_TOKEN: shared bearer secret. Empty (default) leaves the MCP
# server open. docker-compose publishes :8001 on the host LOOPBACK only
# (127.0.0.1:8001), so the open default is reachable by any process on
# the host and by any container on the compose network, nothing further.
# Set it whenever that is not acceptable, and always when the port is
# published beyond loopback. docker-compose forwards the value to BOTH
# mcp-server (which enforces it) and agent-api (whose MCP client sends it
# as `Authorization: Bearer <token>`); comparison is constant-time.
MCP_AUTH_TOKEN=

# MCP_ALLOWED_HOSTS: Host header values the MCP server accepts. The
# DNS-rebinding protection is always on; a request whose Host is not listed
# is refused with 421, and any request carrying a browser Origin header is
# refused outright. Comma-separated, `host:*` matches any port. Blank keeps
# the default: 127.0.0.1:*,localhost:*,[::1]:*,mcp-server:* (loopback plus
# the compose service name). Extend it if you rename the service or front
# the server with another hostname.
MCP_ALLOWED_HOSTS=

# Behavior
# Hybrid retrieval for cve_semantic_search: dense MiniLM cosine fused
# (reciprocal-rank fusion) with an in-process BM25 over the same corpus.
# CVE text is identifier-heavy, which BM25 matches exactly and dense
# embeddings blur. false restores dense-only retrieval. The BM25 index is
# built lazily at first query and cached per process; after re-seeding,
# restart the MCP server to pick up the new corpus.
RETRIEVAL_HYBRID_ENABLED=true
NVD_RATE_LIMIT_PER_30S=5
# Max model requests (ReAct rounds) per triage before the agent is stopped
# with a clean error. Bounds a runaway loop; legitimate triages use far fewer.
AGENT_REQUEST_LIMIT=25
LOG_LEVEL=INFO

# Observability (OpenTelemetry)
# Leave empty for stdout span output (default). Set to an OTLP/HTTP endpoint
# to ship to a backend; the Jaeger compose profile exposes one at :4318.
# Example: http://jaeger:4318  (from inside docker compose)
# Example: http://localhost:4318  (from host shell hitting compose-published port)
OTEL_EXPORTER_OTLP_ENDPOINT=
